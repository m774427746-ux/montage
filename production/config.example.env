# Copy OUTSIDE the repository, e.g. D:\ASBARIX-SERVER\config\production.env
# Never commit real credentials. Use a URL-encoded database password.
DATABASE_URL=postgresql://asbarix_app:REPLACE_LOCALLY@127.0.0.1:5432/asbarix_production
HOST=127.0.0.1
PORT=3000
LOCAL_ORIGIN=http://127.0.0.1:3000
# A NEW dedicated directory; existing machine folders remain untouched.
STORAGE_ROOT=D:\ASBARIX-SERVER\production-data
MIN_FREE_BYTES=2147483648
MAX_FILE_BYTES=4294967296
# Enable only after configuring the matching PRODUCTION_SYNC_SECRET in Preview.
# SYNC_URL=https://YOUR-PREVIEW.vercel.app/api/production
# SYNC_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES_LOCALLY
